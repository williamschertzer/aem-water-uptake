# BTMA-PS: 5 chains x 10 units
# generated by aemwater -- do not edit; edit the template instead

units           real
atom_style      full
boundary        p p p

pair_style      lj/cut/coul/long 10.0 10.0
# GAFF2 is a Lorentz-Berthelot force field. The LAMMPS default for lj/cut is
# GEOMETRIC mixing, which silently changes every cross interaction.
pair_modify     mix arithmetic tail yes
kspace_style    pppm 0.0001
bond_style      harmonic
angle_style     harmonic
dihedral_style  charmm
improper_style  cvff
# Amber 1-4 scaling: LJ/2 and Coulomb/1.2. Applied here, so every CHARMM
# dihedral weight in the data file is 0.
special_bonds   lj 0.0 0.0 0.5 coul 0.0 0.0 0.8333333333

read_data       min.data
neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes
# The ghost-atom cutoff defaults to the pair cutoff + skin. Bonded partners must
# also be within it, and a stretched bond in a freshly packed cell can exceed it,
# which LAMMPS reports as a communication-cutoff warning before losing atoms.
comm_modify     cutoff 12.0

# Molecule IDs are assigned by the data writer in packing order: polymer chains
# first, then counterions, then any water added later. `<>` is LAMMPS's inclusive
# range operator.
group           polymer molecule <> 1 5
group           ions molecule <> 6 55

thermo          500
thermo_style    custom step temp press vol density etotal ke pe ebond eangle edihed evdwl ecoul elong
thermo_modify   flush yes


timestep        1.0
velocity        all create 300.0 20260817 mom yes rot yes dist gaussian

# ---------------------------------------------------------------- stage 3 ----
# NVT at the packing volume: let the melt lose the memory of the packing
# algorithm before the barostat starts changing the box.
fix             nvt_relax all nvt temp 300.0 300.0 100.0
run             5000
unfix           nvt_relax

# ---------------------------------------------------------------- stage 4 ----
# High-temperature anneal. The packed conformations are not melt conformations;
# heating above Tg lets chains interpenetrate, which is what sets the void
# structure that water will later occupy.
fix             nvt_anneal all nvt temp 300.0 600.0 100.0
run             10000
unfix           nvt_anneal
fix             nvt_hold all nvt temp 600.0 600.0 100.0
run             50000
unfix           nvt_hold

# ---------------------------------------------------------------- stage 5 ----
# NPT compression to the operating state, at elevated pressure.
#
# This has to be done under load. Collapsing a 0.35 g/cm3 packing to melt
# density at 1 atm is barostat-limited: the driving force is the ambient
# pressure itself, and the cell creeps. Measured on the validation system, 30k
# steps of iso 1.0 reached 0.70 g/cm3 and stopped climbing -- 35% below a real
# dry AEM, which would have been reported as a converged dry membrane and
# inflated every uptake number downstream, since the water goes into the voids
# that should not be there.
#
# The fix is the standard melt-densification cycle: compress hot and hard, then
# release to the operating pressure and let the density relax back up to its
# equilibrium value from the dense side rather than creeping toward it from the
# dilute side.
fix             npt_squeeze all npt temp 600.0 600.0 100.0 iso 1000.0 1000.0 1000.0
run             20000
unfix           npt_squeeze

# Cool to the operating temperature while still under load, so the chains lose
# mobility at the compressed volume rather than at the dilute one.
fix             npt_cool all npt temp 600.0 300.0 100.0 iso 1000.0 1.0 1000.0
run             10000
unfix           npt_cool

fix             npt_eq all npt temp 300.0 300.0 100.0 iso 1.0 1.0 1000.0
run             100000

# Averages over the production window only, so the compression transient does
# not contaminate the reported density.
variable        dens equal density
variable        vol_ equal vol
fix             avg_dens all ave/time 500 40 20000 v_dens v_vol_ file dry_density.dat
run             100000

# Written WITH coefficients: each stage reads the previous stage's data file, so
# the file has to be self-contained. `nocoeff` would force every downstream stage
# to re-derive the force field, and any drift between the two paths would be
# silent.
write_data      dry.data
write_restart   dry.restart
