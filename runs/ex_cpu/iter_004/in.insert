# iteration 4
# generated by aemwater -- do not edit; edit the template instead

units           real
atom_style      full
boundary        p p p

pair_style      lj/cut/coul/long 10.0 10.0
# GAFF2 is a Lorentz-Berthelot force field. The LAMMPS default for lj/cut is
# GEOMETRIC mixing, which silently changes every cross interaction.
pair_modify     mix arithmetic tail yes
kspace_style    pppm 0.0001
bond_style      harmonic
angle_style     harmonic
dihedral_style  charmm
improper_style  cvff
# Amber 1-4 scaling: LJ/2 and Coulomb/1.2. Applied here, so every CHARMM
# dihedral weight in the data file is 0.
special_bonds   lj 0.0 0.0 0.5 coul 0.0 0.0 0.8333333333

read_data       start.data
neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes
# The ghost-atom cutoff defaults to the pair cutoff + skin. Bonded partners must
# also be within it, and a stretched bond in a freshly packed cell can exceed it,
# which LAMMPS reports as a communication-cutoff warning before losing atoms.
comm_modify     cutoff 12.0

# Molecule IDs are assigned by the data writer in packing order: polymer chains
# first, then counterions, then any water added later. `<>` is LAMMPS's inclusive
# range operator.
group           polymer molecule <> 1 8
group           ions molecule <> 9 168
group           water type 8 9

thermo          500
thermo_style    custom step temp press vol density etotal ke pe ebond eangle edihed evdwl ecoul elong
thermo_modify   flush yes

fix             shake_all all shake 0.0001 20 0 b 8 a 14

timestep        1.0
dump            traj all custom 1000 iter.lammpstrj id mol type q x y z
dump_modify     traj sort id

# ---------------------------------------------------------------- relax -------
# The newly inserted waters were placed in geometric voids, which is not the same
# as an energetically relaxed position. A short NVE/limit run absorbs the initial
# strain without letting any atom move far enough to cross a chain.
fix             nve_settle all nve/limit 0.05
fix             temp_settle all temp/rescale 10 300.0 300.0 10.0 1.0
run             5000
unfix           nve_settle
unfix           temp_settle

min_style       cg
minimize        1e-06 1e-06 20000 200000

# ---------------------------------------------------------------- NPT ---------
# Swelling is the point: the box must be free to expand as water goes in, so the
# uptake is measured at constant pressure, not constant volume.
fix             npt_swell all npt temp 300.0 300.0 100.0 iso 1.0 1.0 1000.0
run             25000

variable        dens equal density
variable        vol_ equal vol
fix             avg all ave/time 500 10 5000 v_dens v_vol_ file density.dat
run             25000

# ------------------------------------------------------------- chemical pot ---
# Widom insertion of a test water into the swollen membrane, to be compared with
# the same quantity in bulk water. The comparison is only meaningful if both
# sides use identical cutoff, kspace accuracy and water model -- see bulk.in.j2.
#
# The test particle is inserted but never kept, so this measures the free energy
# the *next* water would pay, which is exactly the saturation question.
molecule        h2o h2o.mol
fix             w all widom 100 400 0 87235 300.0 mol h2o full_energy
variable        muex equal f_w[1]
variable        boltz equal f_w[2]
variable        wvol equal f_w[3]
fix             muavg all ave/time 100 100 10000 v_muex v_boltz v_wvol file mu.dat
run             50000
unfix           w
unfix           muavg

# Written WITH coefficients: each stage reads the previous stage's data file, so
# the file has to be self-contained. `nocoeff` would force every downstream stage
# to re-derive the force field, and any drift between the two paths would be
# silent.
write_data      relaxed.data
write_restart   relaxed.restart
