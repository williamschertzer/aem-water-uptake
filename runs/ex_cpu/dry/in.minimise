# BTMA-PS: 8 chains x 20 units
# generated by aemwater -- do not edit; edit the template instead

units           real
atom_style      full
boundary        p p p

pair_style      lj/cut/coul/long 10.0 10.0
# GAFF2 is a Lorentz-Berthelot force field. The LAMMPS default for lj/cut is
# GEOMETRIC mixing, which silently changes every cross interaction.
pair_modify     mix arithmetic tail yes
kspace_style    pppm 0.0001
bond_style      harmonic
angle_style     harmonic
dihedral_style  charmm
improper_style  cvff
# Amber 1-4 scaling: LJ/2 and Coulomb/1.2. Applied here, so every CHARMM
# dihedral weight in the data file is 0.
special_bonds   lj 0.0 0.0 0.5 coul 0.0 0.0 0.8333333333

read_data       system.data
neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes
# The ghost-atom cutoff defaults to the pair cutoff + skin. Bonded partners must
# also be within it, and a stretched bond in a freshly packed cell can exceed it,
# which LAMMPS reports as a communication-cutoff warning before losing atoms.
comm_modify     cutoff 12.0

# Molecule IDs are assigned by the data writer in packing order: polymer chains
# first, then counterions, then any water added later. `<>` is LAMMPS's inclusive
# range operator.
group           polymer molecule <> 1 8
group           ions molecule <> 9 168

thermo          500
thermo_style    custom step temp press vol density etotal ke pe ebond eangle edihed evdwl ecoul elong
thermo_modify   flush yes

# ---------------------------------------------------------------- stage 1 ----
# Soft-core push-off. A packed cell can contain contacts closer than any real
# minimum; a 12-6 potential there gives forces large enough to eject atoms
# ("lost atoms") before the minimiser can act. A capped soft potential removes
# the overlaps first, then the real potential is restored.
# `pair_style soft` has no Coulomb term, so the long-range solver has nothing to
# attach to and LAMMPS refuses the combination. Electrostatics are switched off
# for the push-off and restored with the real potential below; the push-off only
# has to separate overlapping atoms, which is a steric problem.
kspace_style    none
pair_style      soft 3.0
pair_coeff      * * 0.0 3.0
variable        prefactor equal ramp(0,60.0)
fix             softpush all adapt 1 pair soft a * * v_prefactor
fix             nve_push all nve/limit 0.05
fix             temp_push all temp/rescale 10 300.0 300.0 10.0 1.0
timestep        1.0
run             20000
unfix           softpush
unfix           nve_push
unfix           temp_push

# Restore the real force field.
pair_style      lj/cut/coul/long 10.0 10.0
pair_modify     mix arithmetic tail yes
kspace_style    pppm 0.0001
pair_coeff      1 1 0.10780000 3.39770953  # c3
pair_coeff      2 2 0.09880000 3.31521231  # ca
pair_coeff      3 3 3.87480000 2.49950544  # n4
pair_coeff      4 4 0.02080000 2.60017700  # hc
pair_coeff      5 5 0.01610000 2.62547852  # ha
pair_coeff      6 6 0.02080000 1.88745802  # hx
pair_coeff      7 7 0.01278500 4.83045000  # Cl_CL

# ---------------------------------------------------------------- stage 2 ----
# Energy minimisation with the real potential. Water is left flexible here;
# SHAKE is applied only once dynamics start, because the minimiser and SHAKE
# fight each other.
min_style       cg
minimize        1e-06 1e-06 20000 200000

# Written WITH coefficients: each stage reads the previous stage's data file, so
# the file has to be self-contained. `nocoeff` would force every downstream stage
# to re-derive the force field, and any drift between the two paths would be
# silent.
write_data      min.data
write_restart   min.restart
