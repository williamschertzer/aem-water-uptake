# Bulk spce reference
# generated by aemwater -- do not edit; edit the template instead

units           real
atom_style      full
boundary        p p p

pair_style      lj/cut/coul/long 10.0 10.0
# GAFF2 is a Lorentz-Berthelot force field. The LAMMPS default for lj/cut is
# GEOMETRIC mixing, which silently changes every cross interaction.
pair_modify     mix arithmetic tail yes
kspace_style    pppm 0.0001
bond_style      harmonic
angle_style     harmonic
dihedral_style  charmm
improper_style  cvff
# Amber 1-4 scaling: LJ/2 and Coulomb/1.2. Applied here, so every CHARMM
# dihedral weight in the data file is 0.
special_bonds   lj 0.0 0.0 0.5 coul 0.0 0.0 0.8333333333

read_data       bulk.data
neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes
# The ghost-atom cutoff defaults to the pair cutoff + skin. Bonded partners must
# also be within it, and a stretched bond in a freshly packed cell can exceed it,
# which LAMMPS reports as a communication-cutoff warning before losing atoms.
comm_modify     cutoff 12.0

# Molecule IDs are assigned by the data writer in packing order: polymer chains
# first, then counterions, then any water added later. `<>` is LAMMPS's inclusive
# range operator.
group           polymer molecule <> 1 0
group           water type 1 2

thermo          500
thermo_style    custom step temp press vol density etotal ke pe ebond eangle edihed evdwl ecoul elong
thermo_modify   flush yes

# ================================================================ BULK WATER ==
# Reference reservoir. The protocol must match the membrane Widom run in every
# detail that shifts mu_ex -- cutoff, kspace accuracy, tail correction, water
# model, insertion count -- because the saturation criterion resolves a
# difference much smaller than any of those systematic shifts.

# ---------------------------------------------------------------- stage 1 ----
# The lattice is overlap-free by construction, so no soft push-off is needed;
# a short minimisation removes the jitter-induced strain.
min_style       cg
minimize        1e-06 1e-06 500 5000

# ---------------------------------------------------------------- stage 2 ----
# Rigid water. SPC/E and TIP3P are *defined* with fixed geometry: integrating
# their internal degrees of freedom gives a different liquid with a different
# chemical potential.
fix             rigid_water all shake 0.0001 20 0 b 1 a 1
timestep        1.0
velocity        all create 300.0 31337 mom yes rot yes dist gaussian

# NPT to the target state point. The lattice melts within a few ps; the run is
# long enough that the density is measured on liquid, not on a melting solid.
fix             npt_bulk all npt temp 300.0 300.0 100.0 iso 1.0 1.0 1000.0
# Variables must exist before the fix that references them: LAMMPS resolves
# v_ names at fix-definition time, not at run time.
variable        dens equal density
variable        vol equal vol
fix             rho all ave/time 500 10 5000 v_dens v_vol file bulk_density.dat
run             50000

# ---------------------------------------------------------------- stage 3 ----
# Widom insertion of a whole rigid water, in the same NPT ensemble the membrane
# run uses. `full_energy` makes LAMMPS evaluate the complete system energy for
# each trial rather than a pairwise shortcut, which is required when kspace is
# active.
molecule        h2o h2o.mol
fix             w all widom 100 400 0 31337 300.0 mol h2o full_energy
variable        muex equal f_w[1]
variable        boltz equal f_w[2]
variable        wvol equal f_w[3]
# Write every insertion-burst observation.  Blocking and uncertainty estimation
# are performed from this time series in aemwater.widom.
fix             muavg all ave/time 100 1 100 v_muex v_boltz v_wvol file bulk_mu.dat
run             50000

write_data      bulk_final.data
