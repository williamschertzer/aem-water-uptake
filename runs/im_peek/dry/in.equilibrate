# Im-PEEK: 2 chains x 5 units
# generated by aemwater -- do not edit; edit the template instead

units           real
atom_style      full
boundary        p p p

pair_style      lj/cut/coul/long 10.0 10.0
# GAFF2 is a Lorentz-Berthelot force field. The LAMMPS default for lj/cut is
# GEOMETRIC mixing, which silently changes every cross interaction.
pair_modify     mix arithmetic tail yes
kspace_style    pppm 0.0001
bond_style      harmonic
angle_style     harmonic
dihedral_style  charmm
improper_style  cvff
# Amber 1-4 scaling: LJ/2 and Coulomb/1.2. Applied here, so every CHARMM
# dihedral weight in the data file is 0.
special_bonds   lj 0.0 0.0 0.5 coul 0.0 0.0 0.8333333333

read_data       min.data
neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes
# The ghost-atom cutoff defaults to the pair cutoff + skin. Bonded partners must
# also be within it, and a stretched bond in a freshly packed cell can exceed it,
# which LAMMPS reports as a communication-cutoff warning before losing atoms.
comm_modify     cutoff 12.0

# Molecule IDs are assigned by the data writer in packing order: polymer chains
# first, then counterions, then any water added later. `<>` is LAMMPS's inclusive
# range operator.
group           polymer molecule <> 1 2
group           ions molecule <> 3 12

thermo          500
thermo_style    custom step temp press vol density etotal ke pe ebond eangle edihed evdwl ecoul elong
thermo_modify   flush yes


timestep        1.0
velocity        all create 300.0 20260817 mom yes rot yes dist gaussian

# ============================================================================
# 21-step compression/decompression equilibration
# Larsen, Lin & Colina, Macromolecules 44 (2011) 6944; the equilibration stage
# of Polymatic (Abbott, Hart & Colina, Theor. Chem. Acc. 132 (2013) 1334).
#
# Seven cycles of (NVT hot / NVT cold / NPT cold), with the pressure ramped up
# to 50000 atm over cycles 1-3 and released
# back to 1.0 atm over cycles 4-7.
#
# The decompression half is the point. A single hot squeeze followed by one
# release plateaus ~18% below the experimental density for this chemistry and
# is still drifting upward when it stops; the leftover volume is void space,
# which the water-uptake loop then fills instead of swelling the cell. Being
# over-compressed and let out in stages, with a hot NVT relaxation between each
# stage, is what collapses those voids rather than freezing them in.
#
# Total: 1560 ps at a 1.0 fs timestep.
# ============================================================================
dump            traj all custom 1000 dry.lammpstrj id mol type q x y z
dump_modify     traj sort id
# -- step  1/21: NVT 600 K -- cycle 1: relax hot at the packing volume
fix             eq1 all nvt temp 600.0 600.0 100.0
run             50000
unfix           eq1
# -- step  2/21: NVT 300 K -- cycle 1: quench to operating temperature
fix             eq2 all nvt temp 300.0 300.0 100.0
run             50000
unfix           eq2
# -- step  3/21: NPT 300 K, 10 atm -- cycle 1: compress at 0.02% of peak
fix             eq3 all npt temp 300.0 300.0 100.0 iso 10.0 10.0 1000.0
run             50000
unfix           eq3
# -- step  4/21: NVT 600 K -- cycle 2: relax hot
fix             eq4 all nvt temp 600.0 600.0 100.0
run             50000
unfix           eq4
# -- step  5/21: NVT 300 K -- cycle 2: quench
fix             eq5 all nvt temp 300.0 300.0 100.0
run             100000
unfix           eq5
# -- step  6/21: NPT 300 K, 300 atm -- cycle 2: compress at 0.6% of peak
fix             eq6 all npt temp 300.0 300.0 100.0 iso 300.0 300.0 1000.0
run             50000
unfix           eq6
# -- step  7/21: NVT 600 K -- cycle 3: relax hot
fix             eq7 all nvt temp 600.0 600.0 100.0
run             50000
unfix           eq7
# -- step  8/21: NVT 300 K -- cycle 3: quench
fix             eq8 all nvt temp 300.0 300.0 100.0
run             100000
unfix           eq8
# -- step  9/21: NPT 300 K, 5e+04 atm -- cycle 3: compress at PEAK pressure
fix             eq9 all npt temp 300.0 300.0 100.0 iso 50000.0 50000.0 1000.0
run             50000
unfix           eq9
# -- step 10/21: NVT 600 K -- cycle 4: relax hot under no load
fix             eq10 all nvt temp 600.0 600.0 100.0
run             50000
unfix           eq10
# -- step 11/21: NVT 300 K -- cycle 4: quench
fix             eq11 all nvt temp 300.0 300.0 100.0
run             100000
unfix           eq11
# -- step 12/21: NPT 300 K, 2.5e+04 atm -- cycle 4: decompress to 50% of peak
fix             eq12 all npt temp 300.0 300.0 100.0 iso 25000.0 25000.0 1000.0
run             5000
unfix           eq12
# -- step 13/21: NVT 600 K -- cycle 5: relax hot
fix             eq13 all nvt temp 600.0 600.0 100.0
run             5000
unfix           eq13
# -- step 14/21: NVT 300 K -- cycle 5: quench
fix             eq14 all nvt temp 300.0 300.0 100.0
run             10000
unfix           eq14
# -- step 15/21: NPT 300 K, 5000 atm -- cycle 5: decompress to 10% of peak
fix             eq15 all npt temp 300.0 300.0 100.0 iso 5000.0 5000.0 1000.0
run             5000
unfix           eq15
# -- step 16/21: NVT 600 K -- cycle 6: relax hot
fix             eq16 all nvt temp 600.0 600.0 100.0
run             5000
unfix           eq16
# -- step 17/21: NVT 300 K -- cycle 6: quench
fix             eq17 all nvt temp 300.0 300.0 100.0
run             10000
unfix           eq17
# -- step 18/21: NPT 300 K, 500 atm -- cycle 6: decompress to 1% of peak
fix             eq18 all npt temp 300.0 300.0 100.0 iso 500.0 500.0 1000.0
run             5000
unfix           eq18
# -- step 19/21: NVT 600 K -- cycle 7: relax hot
fix             eq19 all nvt temp 600.0 600.0 100.0
run             5000
unfix           eq19
# -- step 20/21: NVT 300 K -- cycle 7: quench
fix             eq20 all nvt temp 300.0 300.0 100.0
run             10000
unfix           eq20

# Density is averaged over the production step ONLY, so no part of the
# compression schedule contaminates the reported value. The drift check in
# prepare.py reads this same file and rejects a structure still densifying.
variable        dens equal density
variable        vol_ equal vol
fix             avg_dens all ave/time 500 160 80000 v_dens v_vol_ file dry_density.dat
# -- step 21/21: NPT 300 K, 1 atm -- cycle 7: production NPT at operating pressure
fix             eq21 all npt temp 300.0 300.0 100.0 iso 1.0 1.0 1000.0
run             800000
unfix           eq21

# Written WITH coefficients: each stage reads the previous stage's data file, so
# the file has to be self-contained. `nocoeff` would force every downstream stage
# to re-derive the force field, and any drift between the two paths would be
# silent.
write_data      dry.data
write_restart   dry.restart
