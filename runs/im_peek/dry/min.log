pair_modify     mix arithmetic tail yes
kspace_style    pppm 0.0001
pair_coeff      1 1 0.09880000 3.31521231  # ca
pair_coeff      2 2 0.09880000 3.31521231  # c
pair_coeff      3 3 0.07260000 3.15609780  # os
