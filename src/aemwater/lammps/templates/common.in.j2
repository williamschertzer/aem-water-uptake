{# Shared header: styles, data file, groups and constraints. #}
# {{ title }}
# generated by aemwater -- do not edit; edit the template instead

units           real
atom_style      full
boundary        p p p

pair_style      lj/cut/coul/long {{ md.cutoff }} {{ md.cutoff }}
# GAFF2 is a Lorentz-Berthelot force field. The LAMMPS default for lj/cut is
# GEOMETRIC mixing, which silently changes every cross interaction.
pair_modify     mix arithmetic tail yes
kspace_style    pppm {{ md.kspace_accuracy }}
{% for line in bonded_styles %}{{ line }}
{% endfor %}# Amber 1-4 scaling: LJ/2 and Coulomb/1.2. Applied here, so every CHARMM
# dihedral weight in the data file is 0.
special_bonds   {{ special_bonds }}

read_data       {{ data_file }}{% if extra_types %} extra/atom/types {{ extra_types.atom }} extra/bond/types {{ extra_types.bond }} extra/angle/types {{ extra_types.angle }}{% endif %}

neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes
# The ghost-atom cutoff defaults to the pair cutoff + skin. Bonded partners must
# also be within it, and a stretched bond in a freshly packed cell can exceed it,
# which LAMMPS reports as a communication-cutoff warning before losing atoms.
comm_modify     cutoff {{ comm_cutoff }}

# Molecule IDs are assigned by the data writer in packing order: polymer chains
# first, then counterions, then any water added later. `<>` is LAMMPS's inclusive
# range operator.
group           polymer molecule <> 1 {{ groups.n_polymer_molecules }}
{% if groups.n_ion_molecules > 0 -%}
group           ions molecule <> {{ groups.n_polymer_molecules + 1 }} {{ groups.n_polymer_molecules + groups.n_ion_molecules }}
{% endif -%}
{% if groups.water_type_o -%}
group           water type {{ groups.water_type_o }} {{ groups.water_type_h }}
{% endif %}

thermo          {{ md.thermo_every }}
thermo_style    custom step temp press vol density etotal ke pe ebond eangle edihed evdwl ecoul elong
thermo_modify   flush yes
