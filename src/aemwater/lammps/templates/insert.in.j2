{% include "common.in.j2" %}

{# LAMMPS permits one fix shake per run; ConstraintSpec merges water and X-H. #}
{% if constraints.shake_command -%}
{{ constraints.shake_command }}
{% endif %}

timestep        {{ md.timestep }}
{% if velocity_create -%}
velocity        all create {{ md.temperature }} {{ seed }} mom yes rot yes dist gaussian
{% endif %}

# ---------------------------------------------------------------- relax -------
# The newly inserted waters were placed in geometric voids, which is not the same
# as an energetically relaxed position. A short NVE/limit run absorbs the initial
# strain without letting any atom move far enough to cross a chain.
fix             nve_settle all nve/limit {{ soft.max_displacement }}
fix             temp_settle all temp/rescale 10 {{ md.temperature }} {{ md.temperature }} 10.0 1.0
run             {{ settle_steps }}
unfix           nve_settle
unfix           temp_settle

min_style       cg
minimize        {{ minim.etol }} {{ minim.ftol }} {{ minim.max_iter }} {{ minim.max_eval }}

# ---------------------------------------------------------------- NPT ---------
# Swelling is the point: the box must be free to expand as water goes in, so the
# uptake is measured at constant pressure, not constant volume.
fix             npt_swell all npt temp {{ md.temperature }} {{ md.temperature }} {{ md.tdamp }} iso {{ md.pressure }} {{ md.pressure }} {{ md.pdamp }}
run             {{ npt_equil_steps }}

variable        dens equal density
variable        vol_ equal vol
fix             avg all ave/time {{ md.thermo_every }} {{ n_averages }} {{ md.thermo_every * n_averages }} v_dens v_vol_ file {{ density_file }}
run             {{ npt_prod_steps }}

{% if widom.enabled %}
# ------------------------------------------------------------- chemical pot ---
# Widom insertion of a test water into the swollen membrane, to be compared with
# the same quantity in bulk water. The comparison is only meaningful if both
# sides use identical cutoff, kspace accuracy and water model -- see bulk.in.j2.
#
# The test particle is inserted but never kept, so this measures the free energy
# the *next* water would pay, which is exactly the saturation question.
molecule        h2o {{ water_template }}
fix             w all widom {{ widom.every }} {{ widom.insertions_per_call }} 0 {{ seed }} {{ md.temperature }} mol h2o full_energy
variable        muex equal f_w[1]
variable        boltz equal f_w[2]
variable        wvol equal f_w[3]
fix             muavg all ave/time {{ widom.every }} {{ n_widom_samples }} {{ widom_window }} v_muex v_boltz v_wvol file {{ mu_file }}
run             {{ widom_steps }}
unfix           w
unfix           muavg
{% endif %}

# Written WITH coefficients: each stage reads the previous stage's data file, so
# the file has to be self-contained. `nocoeff` would force every downstream stage
# to re-derive the force field, and any drift between the two paths would be
# silent.
write_data      {{ out_data }}
write_restart   {{ out_restart }}
