{% include "common.in.j2" %}

{# LAMMPS permits one fix shake per run; ConstraintSpec merges water and X-H. #}
{% if constraints.shake_command -%}
{{ constraints.shake_command }}
{% endif %}

timestep        {{ md.timestep }}
{% if velocity_create -%}
velocity        all create {{ md.temperature }} {{ seed }} mom yes rot yes dist gaussian
{% endif %}

# --------------------------------------------------- Widom test insertions ----
# `fix widom` inserts a ghost water at random positions and accumulates
# <exp(-beta*dU)>; it never modifies the configuration, so it can run alongside
# ordinary NPT dynamics. The excess chemical potential of water in the membrane
# is the saturation criterion: once mu_ex(membrane) rises to mu_ex(bulk water),
# inserting another water is no longer thermodynamically favourable.
#
# The molecule template makes every insertion a whole rigid water rather than a
# bare oxygen, which is what makes mu_ex comparable to the bulk reference.
molecule        h2o {{ water_template }}
fix             widom all widom {{ widom.every }} {{ widom.insertions_per_call }} 0 {{ seed }} {{ md.temperature }} mol h2o {% if full_energy %}full_energy{% endif %}

# f_widom[1] = mu_ex (kcal/mol), [2] = <exp(-beta dU)>, [3] = volume (A^3).
variable        mu_ex  equal f_widom[1]
variable        boltz  equal f_widom[2]
variable        wvol   equal f_widom[3]

fix             npt_widom all npt temp {{ md.temperature }} {{ md.temperature }} {{ md.tdamp }} iso {{ md.pressure }} {{ md.pressure }} {{ md.pdamp }}
thermo_style    custom step temp press vol density pe v_mu_ex v_boltz
# Keep one value per insertion burst.  The reader forms contiguous statistical
# blocks from these observations rather than receiving already-blocked data.
fix             avg_mu all ave/time {{ widom.every }} 1 {{ widom.every }} v_mu_ex v_boltz v_wvol file {{ mu_file }}
run             {{ widom.steps_per_block }}

# Written WITH coefficients: each stage reads the previous stage's data file, so
# the file has to be self-contained. `nocoeff` would force every downstream stage
# to re-derive the force field, and any drift between the two paths would be
# silent.
write_data      {{ out_data }}
write_restart   {{ out_restart }}
